rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    // New document bytes are stored as base64 fields in Firestore. Keep Storage read-only
    // for legacy uploads while preventing new document objects from being created.
    match /uploads/{uid}/{file=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || role() in ['admin', 'doctor']);
      allow write: if false;
    }
  }
}
